APP_NAME=appnotas-mcp
# APP_VERSION is read dynamically from the top entry of CHANGELOG.md.
ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Authentication (HTTP transport)
# Generate a token: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_ENABLED=false
API_TOKEN=

# MCP transport security — DNS-rebinding protection
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# HTTP request limits (HTTP transport only)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60.0
MAX_BODY_BYTES=1048576

# Reverse-proxy / path-prefix support (leave empty for local)
# Behind a gateway: BASE_PATH=/appnotas-mcp  ROOT_PATH=/gir-router
BASE_PATH=
ROOT_PATH=

# --- AppNotas (local notes folder) ---
# Absolute path to the notes directory. Leave EMPTY to auto-discover it from the
# AppNotas settings file (%APPDATA%/com.appnotas.desktop/appnotas-settings.json
# -> notesDirectory). Point it at a throwaway folder while developing, e.g.
# NOTES_DIR=C:\Users\<you>\appnotas-mcp-sandbox\notes
NOTES_DIR=
